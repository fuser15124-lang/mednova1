{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mednova-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mednova-ai-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "GROQ_MODEL": "llama-3.3-70b-versatile"
  }
}
